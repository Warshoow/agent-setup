#!/bin/bash
PROJECT_PATH=$(pwd)

if [[ "$PROJECT_PATH" == *"/projects-pro/"* ]]; then
    export CLAUDE_CONFIG_DIR="$HOME/.claude-pro"
    echo "🏢 Compte entreprise activé"
elif [[ "$PROJECT_PATH" == *"/projects-perso/"* ]]; then
    export CLAUDE_CONFIG_DIR="$HOME/.claude-perso"
    echo "🏠 Compte perso activé"
else
    echo "⚠️  Répertoire non reconnu — aucun compte sélectionné"
    echo "   Place-toi dans ~/projects-pro/ ou ~/projects-perso/"
    exit 1
fi

claude "$@"
